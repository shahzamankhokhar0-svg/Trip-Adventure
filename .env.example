# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive Dubai maps.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# SESSION_SECRET: Secret key used to sign admin session cookies (set a strong random string in production).
SESSION_SECRET="change-this-to-a-long-random-secret"

# ADMIN_USERNAME: Admin dashboard login username (defaults to "admin" if unset).
ADMIN_USERNAME="admin"

# ADMIN_PASSWORD: Admin dashboard login password (set a strong password; hashed on boot).
ADMIN_PASSWORD="change-this-admin-password"

# DATABASE_URL: Optional PostgreSQL connection string for external production deployments.
DATABASE_URL=""

# OPTIONAL: SMTP Email Notifications (Not required to run the website; connect later when ready)
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
NOTIFICATION_OWNER_EMAIL=""

# OPTIONAL: WhatsApp Business Cloud API (Not required to run the website; direct WhatsApp links work without it)
WHATSAPP_API_VERSION=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_OWNER_TEMPLATE_NAME=""
WHATSAPP_STATUS_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG=""
